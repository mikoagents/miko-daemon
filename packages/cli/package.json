{
  "name": "@getpaseo/cli",
  "version": "0.8.0-beta.1",
  "private": true,
  "description": "Miko CLI — self-hosted agent execution for Hub",
  "bin": {
    "miko": "bin/miko"
  },
  "files": [
    "bin",
    "dist",
    "!dist/**/*.map"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node ../../scripts/clean-package-dist.mjs",
    "build": "tsc -p tsconfig.json --incremental false",
    "build:clean": "npm run clean && npm run build",
    "prepack": "npm run build:clean",
    "typecheck": "tsgo --noEmit",
    "test:unit": "vitest run src",
    "test:lifecycle": "tsx tests/22-daemon-stop-supervisor.test.ts && tsx tests/23-daemon-sigint-supervisor.test.ts && tsx tests/25-daemon-restart-supervisor.test.ts && tsx tests/35-daemon-worker-supervisor-disconnect.test.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.0.0",
    "@getpaseo/client": "0.8.0-beta.1",
    "@getpaseo/protocol": "0.8.0-beta.1",
    "@getpaseo/server": "0.8.0-beta.1",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "mime-types": "^2.1.35",
    "tree-kill": "^1.2.2",
    "ws": "^8.14.2",
    "yaml": "^2.8.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/mime-types": "^3.0.1",
    "@types/ws": "^8.5.8",
    "tsx": "^4.6.0",
    "typescript": "^5.2.2",
    "vitest": "^4.1.6",
    "zx": "^8.8.5"
  }
}
