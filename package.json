{
  "name": "miko-daemon",
  "version": "0.8.0-beta.1",
  "private": true,
  "description": "Miko execution daemon for Hub, derived from Paseo",
  "keywords": [
    "agents",
    "daemon",
    "hub",
    "mcp"
  ],
  "homepage": "https://github.com/mikoagents/miko-daemon",
  "license": "Apache-2.0",
  "author": {
    "name": "Mohamed Boudra",
    "email": "hello@moboudra.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mikoagents/miko-daemon.git"
  },
  "workspaces": [
    "packages/protocol",
    "packages/client",
    "packages/execution-protocol",
    "packages/server",
    "packages/cli"
  ],
  "scripts": {
    "build": "npm run build:miko",
    "build:protocol": "npm run build --workspace=@getpaseo/protocol",
    "build:client": "npm run build --workspace=@getpaseo/client",
    "build:server-deps": "npm run build:client && npm run build --workspace=@mikoagents/execution-protocol",
    "build:server": "npm run build:server-deps && npm run build --workspace=@getpaseo/server && npm run build --workspace=@getpaseo/cli",
    "build:server:clean": "npm run clean --workspaces --if-present && npm run build:server",
    "build:miko": "npm run build:server",
    "dev": "npm run dev --workspace=@getpaseo/server",
    "cli": "./scripts/dev-home.sh node packages/cli/dist/index.js",
    "pack:miko": "node scripts/pack-miko.mjs",
    "postinstall": "node scripts/postinstall-patches.mjs",
    "prepare": "lefthook install --force",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt .",
    "format:files": "oxfmt",
    "format:check": "oxfmt --check .",
    "format:check:files": "oxfmt --check",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "typecheck:server": "npm run typecheck",
    "typecheck:miko": "npm run typecheck",
    "test:miko": "npm run test --workspace=@mikoagents/execution-protocol && npm run test:miko --workspace=@getpaseo/server",
    "test:core": "npm run test:core --workspace=@getpaseo/server",
    "test:lifecycle": "npm run test:lifecycle --workspace=@getpaseo/cli"
  },
  "devDependencies": {
    "@types/ws": "^8.5.14",
    "@typescript/native-preview": "7.0.0-dev.20260423.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "lefthook": "^2.1.6",
    "oxfmt": "0.46.0",
    "oxlint": "1.61.0",
    "oxlint-tsgolint": "^0.22.1",
    "patch-package": "^8.0.1",
    "typescript": "^5.9.3",
    "ws": "^8.20.0"
  }
}
